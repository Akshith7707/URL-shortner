{
  "name": "url-shortener",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:unit": "jest --testPathPatterns=url-shortener.test",
    "test:local": "jest --testPathPatterns=handlers.local",
    "cdk": "cdk",
    "synth": "cdk synth",
    "local:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/local-setup.ps1",
    "local:setup:jar": "powershell -ExecutionPolicy Bypass -File ./scripts/local-setup-jar.ps1",
    "local:api": "tsx scripts/local-api.ts",
    "local:down": "docker compose down",
    "diff": "cdk diff",
    "deploy": "node -e \"console.error('BLOCKED: cloud deploy disabled for zero-cost mode. See docs/LOCAL.md'); process.exit(1)\"",
    "destroy": "node -e \"console.error('BLOCKED: cloud destroy disabled for zero-cost mode.'); process.exit(1)\""
  },
  "devDependencies": {
    "@swc/core": "^1.15.0",
    "@swc/jest": "^0.2.39",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30",
    "@types/node": "^24.10.1",
    "aws-cdk": "2.1147.0",
    "esbuild": "^0.28.2",
    "jest": "^30",
    "tsx": "^4.23.0",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1161.0",
    "@aws-sdk/lib-dynamodb": "^3.1161.0",
    "aws-cdk-lib": "^2.275.0",
    "constructs": "^10.5.0"
  }
}
